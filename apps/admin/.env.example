NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set separately in this Vercel project. Additional keys below are optional until live model tests are enabled.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional server-only provider keys for admin presence checks. Leave blank for safe absence tests.
# Model tests require explicit enablement and consent. Customer agent binding remains planned. Set real values privately.
BIZOVEYA_NEBIUS_API_KEY=
BIZOVEYA_OPENAI_API_KEY=
BIZOVEYA_GEMINI_API_KEY=

# P04.0 connectivity tests: admin deployment only. Disabled until explicitly enabled.
BIZOVEYA_ENABLE_MODEL_TESTS=false
# Server-only Supabase service-role key used to record attested test outcomes.
# Never use NEXT_PUBLIC_, commit the value or copy it into the web deployment.
SUPABASE_SERVICE_ROLE_KEY=
