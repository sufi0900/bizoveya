BIZOVEYA_MCP_ORIGIN=https://bizoveya.vercel.app
BIZOVEYA_MCP_ALLOWED_CLIENT_IDS=
BIZOVEYA_MCP_ALLOW_DRAFT_WRITES=false

# Development-only customer Ollama pilot through local admin on localhost:3001.
BIZOVEYA_ENABLE_LOCAL_TESTING=false
